{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lyricview",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-03",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"routes": [
		{
			"pattern": "lyricview.hwmnbn.me",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	},
	"ai": {
		"binding": "AI"
	},
	"assets": {
		"directory": "./public/",
		"binding": "ASSETS"
	}
}